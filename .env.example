# Browser-safe Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only AI provider configuration. Set these in Vercel as Secret variables.
AI_API_KEY=YOUR_PROVIDER_API_KEY
AI_BASE_URL=https://api.provider.example/v1
AI_PROVIDER=OpenAI-compatible

# The model identifier is configured by an authorized admin in the dashboard.
